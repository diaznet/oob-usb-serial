# Shell scripts and packaging files must use LF endings to run on Linux,
# regardless of the OS they are edited on.
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.1             text eol=lf
Makefile        text eol=lf
debian/*        text eol=lf
# Files without a matching extension; force LF.
src/bin/oob-usb-serial text eol=lf
src/completion/oob-usb-serial text eol=lf
