[Unit]
Description=OOB USB serial console multiplexer
Documentation=man:oob-usb-serial(1) https://github.com/diaznet/oob-usb-serial/wiki
# Discover adapters once udev has processed the coldplug events. Adapters that
# enumerate late make the first start fail ("no adapters"); the restart policy
# below retries for a few minutes before giving up.
After=systemd-udevd.service systemd-udev-trigger.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# Started as root on purpose: the script reads OOB_USER from
# /etc/oob-usb-serial/oob-usb-serial.conf, prepares /run/oob-usb-serial for
# that user and then re-executes itself as OOB_USER (runuser). Do not add
# User= here; change OOB_USER in the config instead.
Type=forking
ExecStart=/usr/bin/oob-usb-serial start
ExecStop=/usr/bin/oob-usb-serial stop
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
