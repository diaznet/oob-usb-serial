[Unit]
Description=OOB USB serial console multiplexer
Documentation=man:oob-usb-serial
# Give udev time to enumerate the USB serial adapters before we discover them.
After=multi-user.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=forking
EnvironmentFile=-/etc/oob-usb-serial/oob-usb-serial.conf
# Run the detached tmux session as the configured OOB user.
User=oob
# Start the session; tmux new-session -d backgrounds itself, hence Type=forking.
ExecStart=/usr/bin/oob-usb-serial start
ExecStop=/usr/bin/oob-usb-serial stop
Restart=on-failure
RestartSec=5
# The session is a persistent tmux server owned by the service.
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
