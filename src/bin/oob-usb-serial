#!/usr/bin/env bash
#
# oob-usb-serial: out-of-band USB serial console multiplexer
#
# Discovers USB-to-serial adapters attached to the host and opens each one as a
# named window inside a single detached GNU screen session, so the whole set of
# consoles can be reached over SSH from a Raspberry Pi acting as an OOB jump
# host.
#
# Subcommands:
#   discover                 List discovered adapters (raw records)
#   list                     Human-friendly table of adapters + resolved config
#   start                    Generate screenrc and start the detached session
#   attach                   Attach to the session (start it if not running)
#   stop                     Terminate the session
#   status                   Show whether the session is running
#   interactive              dialog picker: open a single device at a chosen speed
#   config [--generate]      Show/append device mappings; --generate writes the screenrc
#   help                     Show this help
#
# Configuration:
#   /etc/oob-usb-serial/oob-usb-serial.conf   global defaults
#   /etc/oob-usb-serial/devices.conf          per-device mappings

set -o errexit
set -o nounset
set -o pipefail

PROG="oob-usb-serial"

# ---------------------------------------------------------------------------
# Locate the library directory. Support both installed layout (/usr/lib/...)
# and running straight from a checked-out source tree (../lib relative to bin).
# ---------------------------------------------------------------------------
_self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -f "/usr/lib/${PROG}/discover.sh" ]; then
    OOB_LIB_DIR="/usr/lib/${PROG}"
elif [ -f "${_self_dir}/../lib/discover.sh" ]; then
    OOB_LIB_DIR="$(cd "${_self_dir}/../lib" && pwd)"
else
    printf '%s: cannot locate library directory\n' "$PROG" >&2
    exit 1
fi
export OOB_LIB_DIR

# ---------------------------------------------------------------------------
# Configuration defaults, then load the global config file if present.
# ---------------------------------------------------------------------------
OOB_CONF="${OOB_CONF:-/etc/${PROG}/oob-usb-serial.conf}"
OOB_DEVICES_CONF="${OOB_DEVICES_CONF:-/etc/${PROG}/devices.conf}"
OOB_SPEEDS_FILE="${OOB_SPEEDS_FILE:-/usr/share/${PROG}/serial_speeds.txt}"
OOB_FRAMINGS_FILE="${OOB_FRAMINGS_FILE:-/usr/share/${PROG}/serial_framings.txt}"

OOB_DEFAULT_SPEED="9600"
OOB_DEFAULT_FRAMING="cs8,-parenb,-cstopb"
OOB_SESSION_NAME="oob"
OOB_RUNTIME_DIR="/run/${PROG}"

if [ -f "$OOB_CONF" ]; then
    # shellcheck source=/dev/null
    . "$OOB_CONF"
fi

export OOB_DEFAULT_SPEED OOB_DEFAULT_FRAMING OOB_SESSION_NAME OOB_DEVICES_CONF

# shellcheck source=../lib/discover.sh
. "${OOB_LIB_DIR}/discover.sh"
# shellcheck source=../lib/screenrc-gen.sh
. "${OOB_LIB_DIR}/screenrc-gen.sh"

_err()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
_die()  { _err "$*"; exit 1; }

_require() {
    command -v "$1" >/dev/null 2>&1 || _die "required command '$1' not found"
}

# _oob_device_accessible <devnode>
# Returns 0 if the device exists and is readable+writable by this user.
_oob_device_accessible() {
    [ -e "$1" ] && [ -r "$1" ] && [ -w "$1" ]
}

# _oob_perm_hint <devnode>
# Print an actionable message explaining how to gain serial access. This is the
# common failure: the invoking user is not in the 'dialout' group, so screen
# would open the device and immediately terminate with no useful output.
_oob_perm_hint() {
    local dev="$1" grp
    grp="$(stat -c '%G' "$dev" 2>/dev/null || echo dialout)"
    _err "cannot access ${dev}: permission denied."
    _err "Add your user to the '${grp}' group, then log out and back in:"
    _err "    sudo usermod -aG ${grp} \$USER"
    _err "(the packaged 'oob' user is added to dialout automatically.)"
}

# _oob_custom_framing
# Prompt for each serial parameter separately (data bits, parity, stop bits,
# flow control) via dialog menus and echo the assembled comma-separated stty
# framing string. Requires dialog.
_oob_custom_framing() {
    local sel data parity stop flow

    sel="$(dialog --nocancel --keep-tite --default-item 8 \
        --menu "Data bits:" 12 50 4 \
        5 "5" 6 "6" 7 "7" 8 "8" 2>&1 >/dev/tty)"
    case "$sel" in
        5) data="cs5" ;; 6) data="cs6" ;; 7) data="cs7" ;; *) data="cs8" ;;
    esac

    sel="$(dialog --nocancel --keep-tite --default-item none \
        --menu "Parity:" 12 50 3 \
        none "None" even "Even" odd "Odd" 2>&1 >/dev/tty)"
    case "$sel" in
        even) parity="parenb,-parodd" ;;
        odd)  parity="parenb,parodd" ;;
        *)    parity="-parenb" ;;
    esac

    sel="$(dialog --nocancel --keep-tite --default-item 1 \
        --menu "Stop bits:" 12 50 2 \
        1 "1" 2 "2" 2>&1 >/dev/tty)"
    case "$sel" in
        2) stop="cstopb" ;; *) stop="-cstopb" ;;
    esac

    sel="$(dialog --nocancel --keep-tite --default-item none \
        --menu "Flow control:" 12 60 3 \
        none "None" rtscts "Hardware (RTS/CTS)" xonxoff "Software (XON/XOFF)" \
        2>&1 >/dev/tty)"
    case "$sel" in
        rtscts)  flow="crtscts" ;;
        xonxoff) flow="-crtscts,ixon,ixoff" ;;
        *)       flow="-crtscts,-ixon,-ixoff" ;;
    esac

    printf '%s,%s,%s,%s' "$data" "$parity" "$stop" "$flow"
}

_screenrc_path() {
    mkdir -p "$OOB_RUNTIME_DIR" 2>/dev/null || true
    if [ -w "$OOB_RUNTIME_DIR" ] || mkdir -p "$OOB_RUNTIME_DIR" 2>/dev/null; then
        printf '%s/screenrc' "$OOB_RUNTIME_DIR"
    else
        printf '%s/oob-usb-serial-screenrc.%s' "${TMPDIR:-/tmp}" "$(id -u)"
    fi
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_discover() {
    oob_discover_raw
}

cmd_list() {
    local raw
    raw="$(oob_discover_raw)"
    if [ -z "$raw" ]; then
        printf 'No USB serial adapters found.\n'
        return 0
    fi

    printf '%-14s %-12s %-8s %-10s %s\n' "DEVICE" "NAME" "BAUD" "FRAMING" "ID_SERIAL"
    printf '%-14s %-12s %-8s %-10s %s\n' "------" "----" "----" "-------" "---------"

    local devnode id_serial vendor model cfg name baud framing
    while IFS=$'\t' read -r devnode id_serial vendor model; do
        [ -z "${devnode:-}" ] && continue
        : "$vendor" "$model"   # read for field alignment; not displayed here
        cfg="$(_oob_lookup_config "$id_serial")"
        if [ -n "$cfg" ]; then
            IFS='|' read -r name baud framing <<< "$cfg"
        else
            name="(auto)"
            baud="$OOB_DEFAULT_SPEED"
            framing="$OOB_DEFAULT_FRAMING"
        fi
        printf '%-14s %-12s %-8s %-10s %s\n' \
            "$devnode" "$name" "$baud" "$framing" "$id_serial"
    done <<< "$raw"
}

_session_running() {
    _require screen
    screen -ls 2>/dev/null | grep -qE "[0-9]+\.${OOB_SESSION_NAME}[[:space:]]"
}

cmd_start() {
    _require screen
    if _session_running; then
        _err "session '${OOB_SESSION_NAME}' already running (use 'attach' or 'stop')"
        return 0
    fi

    local rc
    rc="$(_screenrc_path)"
    if ! oob_generate_screenrc > "$rc"; then
        _err "no adapters discovered; not starting an empty session"
        return 1
    fi

    # Warn about any adapters this user cannot open. Their screen windows would
    # otherwise appear then die with no explanation. Non-fatal: the session may
    # still be useful for the accessible devices.
    local devnode inaccessible=0
    while IFS= read -r devnode; do
        [ -z "$devnode" ] && continue
        if ! _oob_device_accessible "$devnode"; then
            inaccessible=$((inaccessible + 1))
            _err "warning: cannot access ${devnode} (its console window will not stay open)"
        fi
    done < <(oob_discover_devnodes)
    if [ "$inaccessible" -gt 0 ]; then
        local anydev
        anydev="$(oob_discover_devnodes | head -1)"
        _oob_perm_hint "${anydev:-/dev/ttyUSB0}"
    fi

    # Start detached, named session using the generated screenrc.
    screen -dmS "$OOB_SESSION_NAME" -c "$rc"
    _err "started detached session '${OOB_SESSION_NAME}' (attach with: $PROG attach)"
}

cmd_attach() {
    _require screen
    if ! _session_running; then
        cmd_start
    fi
    # -R reattaches if possible, otherwise creates; -S targets our session.
    exec screen -R -S "$OOB_SESSION_NAME"
}

cmd_stop() {
    _require screen
    if ! _session_running; then
        _err "session '${OOB_SESSION_NAME}' is not running"
        return 0
    fi
    screen -S "$OOB_SESSION_NAME" -X quit
    _err "stopped session '${OOB_SESSION_NAME}'"
}

cmd_status() {
    if _session_running; then
        printf "session '%s': running\n" "$OOB_SESSION_NAME"
        screen -ls 2>/dev/null | grep -E "[0-9]+\.${OOB_SESSION_NAME}[[:space:]]" || true
        return 0
    fi
    printf "session '%s': not running\n" "$OOB_SESSION_NAME"
    return 3
}

cmd_interactive() {
    _require dialog
    _require screen

    # --- pick a speed ---
    local speeds_file="$OOB_SPEEDS_FILE"
    [ -f "$speeds_file" ] || speeds_file=""
    local -a speed_menu=()
    local n=0 line
    if [ -n "$speeds_file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            [ -z "${line//[[:space:]]/}" ] && continue
            n=$((n + 1))
            speed_menu+=( "$n" "$line" )
        done < "$speeds_file"
    fi
    if [ "${#speed_menu[@]}" -eq 0 ]; then
        speed_menu=( 1 9600 2 19200 3 38400 4 57600 5 115200 )
    fi

    local choice speed
    choice="$(dialog --nocancel --keep-tite --menu "Select speed:" 22 76 16 \
        "${speed_menu[@]}" 2>&1 >/dev/tty)"
    speed="${speed_menu[$(( choice * 2 - 1 ))]}"

    # --- pick a framing preset ---
    # Presets come from OOB_FRAMINGS_FILE (label|stty-options per line) so they
    # can be edited without touching this script. Parallel arrays keep the menu
    # label and the underlying stty options in step.
    local -a fr_menu=() fr_opts=()
    local fr_label fr_opt
    if [ -f "$OOB_FRAMINGS_FILE" ]; then
        n=0
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%%#*}"
            [ -z "${line//[[:space:]]/}" ] && continue
            fr_label="${line%%|*}"
            fr_opt="${line#*|}"
            # Trim surrounding whitespace.
            fr_label="$(printf '%s' "$fr_label" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
            fr_opt="$(printf '%s' "$fr_opt" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
            [ -z "$fr_label" ] && continue
            n=$((n + 1))
            fr_menu+=( "$n" "$fr_label" )
            fr_opts+=( "$fr_opt" )
        done < "$OOB_FRAMINGS_FILE"
    fi
    if [ "${#fr_menu[@]}" -eq 0 ]; then
        fr_menu=( 1 "8N1 (no flow control)" )
        fr_opts=( "cs8,-parenb,-cstopb" )
    fi

    # Offer a "Custom" entry (tag 0) alongside the presets so any combination
    # of parameters can be chosen without a matching preset.
    local framing
    choice="$(dialog --nocancel --keep-tite --menu "Select framing:" 22 76 16 \
        0 "Custom (choose each parameter)" \
        "${fr_menu[@]}" 2>&1 >/dev/tty)"
    if [ "$choice" = "0" ]; then
        framing="$(_oob_custom_framing)"
    else
        # fr_opts is 0-indexed; the preset menu tags are 1-based.
        framing="${fr_opts[$(( choice - 1 ))]}"
    fi

    # --- pick a device ---
    local -a dev_menu=()
    local raw devnode id_serial vendor model
    raw="$(oob_discover_raw)"
    [ -z "$raw" ] && _die "no USB serial adapters found"
    n=0
    while IFS=$'\t' read -r devnode id_serial vendor model; do
        [ -z "${devnode:-}" ] && continue
        n=$((n + 1))
        dev_menu+=( "$n" "${devnode} [${model}/${id_serial}]" )
    done <<< "$raw"

    choice="$(dialog --nocancel --keep-tite --menu "Select device:" 22 76 16 \
        "${dev_menu[@]}" 2>&1 >/dev/tty)"
    # Extract the /dev node (first field of the label).
    local label device
    label="${dev_menu[$(( choice * 2 - 1 ))]}"
    device="${label%% *}"

    # Pre-flight: if we can't open the device, screen would just terminate
    # silently. Fail early with an actionable message instead.
    if ! _oob_device_accessible "$device"; then
        _oob_perm_hint "$device"
        exit 1
    fi

    # Apply the chosen framing to the tty before screen attaches. screen sets
    # the baud rate; stty handles data bits / parity / stop bits / flow control.
    local stty_args
    stty_args="$(printf '%s' "$framing" | tr ',' ' ')"
    if [ -n "$stty_args" ]; then
        # shellcheck disable=SC2086  # intentional word-splitting of stty opts
        stty -F "$device" "$speed" $stty_args 2>/dev/null \
            || _err "warning: could not fully apply framing '${framing}' to ${device}"
    fi

    printf 'Opening %s at %s baud (%s)...\n' "$device" "$speed" "$framing"
    printf 'To leave the session: Ctrl-a k (kill) or Ctrl-a \\ (quit).\n'
    exec screen "$device" "$speed"
}

# _oob_append_section <conf> <name> <id_serial> <baud> <framing>
# Append one INI device section, creating the file if needed.
_oob_append_section() {
    local conf="$1" name="$2" id="$3" baud="$4" framing="$5"
    {
        printf '\n[%s]\n' "$name"
        printf 'match   = %s\n' "$id"
        printf 'baud    = %s\n' "$baud"
        printf 'framing = %s\n' "$framing"
    } >> "$conf"
}

# Interactive scaffolder: walk each discovered adapter and, for the ones not
# already mapped, prompt for a window name / baud / framing and append an INI
# section to devices.conf. Non-interactive `--generate` dumps the screenrc.
cmd_config() {
    if [ "${1:-}" = "--generate" ]; then
        oob_generate_screenrc
        return $?
    fi

    local raw
    raw="$(oob_discover_raw)"
    if [ -z "$raw" ]; then
        printf 'No USB serial adapters found. Plug in an adapter and retry.\n'
        return 0
    fi

    # Ensure we can write the config (it usually lives under /etc).
    if [ -e "$OOB_DEVICES_CONF" ] && [ ! -w "$OOB_DEVICES_CONF" ]; then
        _die "cannot write ${OOB_DEVICES_CONF} (re-run with sudo)"
    fi
    if [ ! -e "$OOB_DEVICES_CONF" ]; then
        local dir; dir="$(dirname "$OOB_DEVICES_CONF")"
        { mkdir -p "$dir" && touch "$OOB_DEVICES_CONF"; } 2>/dev/null \
            || _die "cannot create ${OOB_DEVICES_CONF} (re-run with sudo)"
    fi

    printf 'Configuring device mappings in %s\n' "$OOB_DEVICES_CONF"
    printf 'Press Enter to accept the [default], or type "s" to skip a device.\n\n'

    # Read discovery records on FD 3 so interactive prompts can use stdin (FD 0)
    # without the loop and `read` competing for the same input.
    local devnode id_serial vendor model existing added=0
    while IFS=$'\t' read -r -u 3 devnode id_serial vendor model; do
        [ -z "${devnode:-}" ] && continue

        # Skip adapters already covered by an existing mapping.
        existing="$(_oob_lookup_config "$id_serial")"
        if [ -n "$existing" ]; then
            printf '  %s [%s] -> already mapped as "%s", skipping.\n' \
                "$devnode" "$model" "${existing%%|*}"
            continue
        fi

        printf '  Device: %s\n    model=%s serial=%s\n' "$devnode" "$model" "$id_serial"

        # Default window name derived from model/serial.
        local def_name reply name baud framing
        def_name="$(printf '%s' "${model:-serial}_${id_serial}" \
            | tr -c 'A-Za-z0-9_.-' '_' | sed 's/__*/_/g; s/^_//; s/_$//')"
        def_name="${def_name:0:24}"

        printf '    name [%s] (or "s" to skip): ' "$def_name"
        read -r reply || reply=""
        case "$reply" in
            s|S|skip) printf '    skipped.\n\n'; continue ;;
            "") name="$def_name" ;;
            *) name="$reply" ;;
        esac

        printf '    baud [%s]: ' "$OOB_DEFAULT_SPEED"
        read -r reply || reply=""
        baud="${reply:-$OOB_DEFAULT_SPEED}"

        printf '    framing [%s]: ' "$OOB_DEFAULT_FRAMING"
        read -r reply || reply=""
        framing="${reply:-$OOB_DEFAULT_FRAMING}"

        _oob_append_section "$OOB_DEVICES_CONF" "$name" "$id_serial" "$baud" "$framing"
        added=$((added + 1))
        printf '    added [%s] (match = %s)\n\n' "$name" "$id_serial"
    done 3<<< "$raw"

    if [ "$added" -gt 0 ]; then
        printf 'Wrote %d new mapping(s) to %s\n' "$added" "$OOB_DEVICES_CONF"
        printf "Apply them with: %s start   (or 'stop' then 'start' if running)\n" "$PROG"
    else
        printf 'No new mappings added.\n'
    fi
}

usage() {
    cat <<EOF
${PROG} - out-of-band USB serial console multiplexer

Usage: ${PROG} <command> [args]

Commands:
  discover              List discovered adapters (raw tab-separated records)
  list                  Human-friendly table of adapters + resolved config
  start                 Start the detached screen session (one window/adapter)
  attach                Attach to the session (starting it if needed)
  stop                  Terminate the session
  status                Show whether the session is running
  interactive           dialog picker: open a single device at a chosen speed
  config                Interactively map discovered adapters into devices.conf
  config --generate     Print the generated screenrc (no changes made)
  help                  Show this help

Config:
  ${OOB_CONF}
  ${OOB_DEVICES_CONF}
EOF
}

main() {
    local sub="${1:-help}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        discover)    cmd_discover "$@" ;;
        list)        cmd_list "$@" ;;
        start)       cmd_start "$@" ;;
        attach)      cmd_attach "$@" ;;
        stop)        cmd_stop "$@" ;;
        status)      cmd_status "$@" ;;
        interactive) cmd_interactive "$@" ;;
        config)      cmd_config "$@" ;;
        help|-h|--help) usage ;;
        *) _err "unknown command: $sub"; usage; exit 2 ;;
    esac
}

main "$@"
