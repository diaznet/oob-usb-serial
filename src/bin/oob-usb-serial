#!/usr/bin/env bash
#
# oob-usb-serial: out-of-band USB serial console multiplexer
#
# Discovers USB-to-serial adapters attached to the host and opens each one as a
# named window inside a single detached tmux session, each window running tio
# on the adapter's stable /dev/serial path. The whole set of consoles is then
# reachable over SSH from a Raspberry Pi acting as an OOB jump host.
#
# Subcommands:
#   discover              List discovered adapters (raw tab-separated records)
#   list                  Human-friendly table of adapters + resolved config
#   start                 Start the detached tmux session (one window/adapter)
#   attach                Attach to the session (starting it if needed)
#   stop                  Terminate the session
#   restart               Stop then start the session
#   status                Show whether the session is running
#   config                Map discovered adapters into devices.conf
#   help                  Show this help
#
# Configuration:
#   /etc/oob-usb-serial/oob-usb-serial.conf   global defaults
#   /etc/oob-usb-serial/devices.conf          per-device mappings
#
# Environment overrides (mainly for tests):
#   OOB_CONF, OOB_DEVICES_CONF   config file locations
#   OOB_LIB_DIR                  library directory
#   OOB_TMUX_SOCKET              tmux socket name (default: oob)
#   OOB_SYSFS_ROOT, OOB_DEV_ROOT see lib/discover.sh

set -o errexit
set -o nounset
set -o pipefail

PROG="oob-usb-serial"

# ---------------------------------------------------------------------------
# Locate the library directory: explicit override, then the source tree next
# to this script, then the installed location.
# ---------------------------------------------------------------------------
_self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -n "${OOB_LIB_DIR:-}" ] && [ -f "${OOB_LIB_DIR}/discover.sh" ]; then
    :
elif [ -f "${_self_dir}/../lib/discover.sh" ]; then
    OOB_LIB_DIR="$(cd "${_self_dir}/../lib" && pwd)"
elif [ -f "/usr/lib/${PROG}/discover.sh" ]; then
    OOB_LIB_DIR="/usr/lib/${PROG}"
else
    printf '%s: cannot locate library directory\n' "$PROG" >&2
    exit 1
fi
export OOB_LIB_DIR

# ---------------------------------------------------------------------------
# Configuration defaults, then load the global config file if present.
# ---------------------------------------------------------------------------
OOB_CONF="${OOB_CONF:-/etc/${PROG}/oob-usb-serial.conf}"
OOB_DEVICES_CONF="${OOB_DEVICES_CONF:-/etc/${PROG}/devices.conf}"

OOB_DEFAULT_BAUD="115200"
OOB_DEFAULT_DATA="8"
OOB_DEFAULT_PARITY="none"
OOB_DEFAULT_STOP="1"
OOB_DEFAULT_FLOW="none"
OOB_SESSION_NAME="oob"
OOB_LOG_DIR=""
OOB_USER="oob"
OOB_RUNTIME_DIR="${OOB_RUNTIME_DIR:-/run/${PROG}}"

if [ -f "$OOB_CONF" ]; then
    # shellcheck source=/dev/null
    . "$OOB_CONF"
fi

export OOB_DEFAULT_BAUD OOB_DEFAULT_DATA OOB_DEFAULT_PARITY OOB_DEFAULT_STOP \
       OOB_DEFAULT_FLOW OOB_SESSION_NAME OOB_LOG_DIR OOB_USER OOB_DEVICES_CONF OOB_RUNTIME_DIR

# shellcheck source=../lib/discover.sh
. "${OOB_LIB_DIR}/discover.sh"
# shellcheck source=../lib/session-gen.sh
. "${OOB_LIB_DIR}/session-gen.sh"

# tmux is always driven on a dedicated, named socket. NOTE: `tmux -L NAME` is
# per-user (the socket lives under the caller's runtime dir), so the session
# commands must all run as OOB_USER to share the one real server. See
# _ensure_oob_user below.
TMUX_SOCKET="${OOB_TMUX_SOCKET:-oob}"
_tmux() { tmux -L "$TMUX_SOCKET" "$@"; }

_err()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
_die()  { _err "$*"; exit 1; }

_require() {
    command -v "$1" >/dev/null 2>&1 || _die "required command '$1' not found"
}

# _oob_prepare_dirs
# Run as root before dropping to OOB_USER: create the runtime directory (and
# the log directory, if configured) owned by OOB_USER. Existing directories
# are never re-owned, so a misconfigured path cannot hand a system directory
# to OOB_USER.
_oob_prepare_dirs() {
    local grp dir
    grp="$(id -gn "$OOB_USER" 2>/dev/null || printf '%s' "$OOB_USER")"
    for dir in "$OOB_RUNTIME_DIR" "$OOB_LOG_DIR"; do
        [ -n "$dir" ] || continue
        [ -e "$dir" ] && continue
        install -d -m 0750 -o "$OOB_USER" -g "$grp" "$dir" 2>/dev/null \
            || _err "warning: could not create ${dir}"
    done
}

# _ensure_oob_user
# Session commands (start/stop/attach/status) must act on OOB_USER's tmux
# server. Because `tmux -L` sockets are per-user, running as anyone else would
# create or inspect a *different* server. If the caller is not OOB_USER:
#   * as root -> prepare directories, then re-exec the whole command as
#                OOB_USER (runuser, fallback sudo)
#   * otherwise -> refuse with a clear message.
# When the caller already is OOB_USER, this is a no-op.
_ensure_oob_user() {
    local me
    me="$(id -un)"
    [ "$me" = "$OOB_USER" ] && return 0

    if ! getent passwd "$OOB_USER" >/dev/null 2>&1; then
        _die "user '${OOB_USER}' does not exist (set OOB_USER in ${OOB_CONF})"
    fi

    if [ "$(id -u)" = "0" ]; then
        _oob_prepare_dirs
        if command -v runuser >/dev/null 2>&1; then
            exec runuser -u "$OOB_USER" -- "$0" "$@"
        elif command -v sudo >/dev/null 2>&1; then
            exec sudo -u "$OOB_USER" -- "$0" "$@"
        else
            _die "cannot switch to '${OOB_USER}': neither runuser nor sudo found"
        fi
    fi

    _die "run this as '${OOB_USER}' (e.g. via sudo); the session belongs to that user"
}

# _oob_device_accessible <path>
# Returns 0 if the device (or its symlink target) is readable+writable.
_oob_device_accessible() {
    local real
    real="$(readlink -f "$1" 2>/dev/null || printf '%s' "$1")"
    [ -e "$real" ] && [ -r "$real" ] && [ -w "$real" ]
}

# _oob_perm_hint <path>
# Explain how to gain serial access (join the dialout group).
_oob_perm_hint() {
    local dev="$1" real grp
    real="$(readlink -f "$dev" 2>/dev/null || printf '%s' "$dev")"
    grp="$(stat -c '%G' "$real" 2>/dev/null || echo dialout)"
    _err "cannot access ${dev}: permission denied."
    _err "Add your user to the '${grp}' group, then log out and back in:"
    _err "    sudo usermod -aG ${grp} \$USER"
    _err "(the packaged '${OOB_USER}' user is added to dialout automatically.)"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_discover() {
    oob_discover_raw
}

cmd_list() {
    local resolved
    resolved="$(oob_resolve)"
    if [ -z "$resolved" ]; then
        printf 'No USB serial adapters found.\n'
        return 0
    fi

    printf '%-24s %-5s %-13s %-8s %-8s %s\n' \
        "NAME" "FROM" "DEVICE" "BAUD" "FRAMING" "ID_SERIAL"
    printf '%-24s %-5s %-13s %-8s %-8s %s\n' \
        "----" "----" "------" "----" "-------" "---------"

    local name baud data parity stop flow target devnode id_serial bypath mapped from
    while IFS=$'\t' read -r name baud data parity stop flow target devnode id_serial mapped bypath; do
        [ -n "${name:-}" ] || continue
        if [ "$mapped" = "yes" ]; then from="conf"; else from="auto"; fi
        printf '%-24s %-5s %-13s %-8s %-8s %s\n' \
            "$name" "$from" "${devnode##*/}" "$baud" \
            "$(_oob_framing_summary "$data" "$parity" "$stop" "$flow")" "$id_serial"
        printf '    opens: %s\n' "$target"
        if [ -n "$bypath" ] && [ "$bypath" != "$target" ]; then
            printf '    port:  %s\n' "$bypath"
        fi
    done <<< "$resolved"
}

_session_running() {
    _tmux has-session -t "$OOB_SESSION_NAME" 2>/dev/null
}

cmd_start() {
    _require tmux
    _require tio
    if _session_running; then
        _err "session '${OOB_SESSION_NAME}' already running (use 'attach' or 'stop')"
        return 0
    fi

    local resolved
    resolved="$(oob_resolve)"
    if [ -z "$resolved" ]; then
        _err "no adapters discovered; not starting an empty session"
        return 1
    fi

    if [ -n "$OOB_LOG_DIR" ]; then
        mkdir -p "$OOB_LOG_DIR" 2>/dev/null \
            || _err "warning: could not create log dir ${OOB_LOG_DIR}"
    fi

    # Read tio's version once, in this shell, so the per-window command
    # builders (run in subshells) share the cached value.
    _oob_tio_version >/dev/null

    local rundir tmuxconf
    rundir="$(oob_runtime_dir)"
    tmuxconf="${rundir}/tmux.conf"
    oob_generate_tmux_config > "$tmuxconf"

    local name baud data parity stop flow target devnode id_serial bypath mapped
    local first=1 windows=0 denied=""
    while IFS=$'\t' read -r name baud data parity stop flow target devnode id_serial mapped bypath; do
        [ -n "${name:-}" ] || continue
        : "$devnode" "$id_serial" "$bypath" "$mapped"

        if ! _oob_device_accessible "$target"; then
            [ -n "$denied" ] || denied="$target"
            _err "warning: cannot access ${target} (its console window may not stay open)"
        fi

        local tio_cmd
        tio_cmd="$(_oob_tio_command "$name" "$target" "$baud" "$data" "$parity" "$stop" "$flow")"

        if [ "$first" -eq 1 ]; then
            _tmux -f "$tmuxconf" new-session -d -s "$OOB_SESSION_NAME" -n "$name" "$tio_cmd"
            first=0
        else
            _tmux new-window -t "$OOB_SESSION_NAME" -n "$name" "$tio_cmd"
        fi
        windows=$((windows + 1))
    done <<< "$resolved"

    # tmux has read its config once the server is up; drop a temporary copy.
    if [ "$rundir" != "$OOB_RUNTIME_DIR" ]; then
        rm -rf -- "$rundir"
    fi

    if [ "$windows" -eq 0 ]; then
        _err "no adapters opened; not starting an empty session"
        return 1
    fi

    _tmux select-window -t "$OOB_SESSION_NAME:0" 2>/dev/null || true

    if [ -n "$denied" ]; then
        _oob_perm_hint "$denied"
    fi
    _err "started detached session '${OOB_SESSION_NAME}' with ${windows} console(s) (attach with: $PROG attach)"
}

cmd_attach() {
    _require tmux
    if ! _session_running; then
        cmd_start
    fi
    exec tmux -L "$TMUX_SOCKET" attach-session -t "$OOB_SESSION_NAME"
}

cmd_stop() {
    _require tmux
    if ! _session_running; then
        _err "session '${OOB_SESSION_NAME}' is not running"
        return 0
    fi
    _tmux kill-session -t "$OOB_SESSION_NAME"
    _err "stopped session '${OOB_SESSION_NAME}'"
}

cmd_restart() {
    if _session_running; then
        cmd_stop
    fi
    cmd_start
}

cmd_status() {
    if _session_running; then
        printf "session '%s': running\n" "$OOB_SESSION_NAME"
        _tmux list-windows -t "$OOB_SESSION_NAME" 2>/dev/null || true
        return 0
    fi
    printf "session '%s': not running\n" "$OOB_SESSION_NAME"
    return 3
}

# _oob_append_section <conf> <name> <id_serial> <path> <baud> <data> <parity> <stop> <flow>
# <path> may be empty (no path key written).
_oob_append_section() {
    local conf="$1" name="$2" id="$3" path="$4" baud="$5" data="$6" parity="$7" stop="$8" flow="$9"
    {
        printf '\n[%s]\n' "$name"
        printf 'match  = %s\n' "$id"
        [ -z "$path" ] || printf 'path   = %s\n' "$path"
        printf 'baud   = %s\n' "$baud"
        printf 'data   = %s\n' "$data"
        printf 'parity = %s\n' "$parity"
        printf 'stop   = %s\n' "$stop"
        printf 'flow   = %s\n' "$flow"
    } >> "$conf"
}

# _oob_ask <label> <default> <validator>
# Prompt until the answer passes <validator> (Enter accepts the default; EOF
# takes the default). The answer is left in _OOB_ANSWER.
_OOB_ANSWER=""
_oob_ask() {
    local label="$1" def="$2" check="$3" reply
    while :; do
        printf '    %s [%s]: ' "$label" "$def"
        if ! read -r reply; then
            printf '\n'
            _OOB_ANSWER="$def"
            return 0
        fi
        reply="$(_oob_trim "$reply")"
        [ -n "$reply" ] || reply="$def"
        if "$check" "$reply"; then
            _OOB_ANSWER="$reply"
            return 0
        fi
        printf '    invalid value "%s", try again.\n' "$reply"
    done
}

# Config scaffolder: for each unmapped adapter, prompt for name + serial line
# settings and append an INI section to devices.conf. Adapters that share an
# ID_SERIAL with another attached adapter also get a `path` key (their USB
# port) so each one is mapped separately.
cmd_config() {
    local raw
    raw="$(oob_discover_raw)"
    if [ -z "$raw" ]; then
        printf 'No USB serial adapters found. Plug in an adapter and retry.\n'
        return 0
    fi

    if [ -e "$OOB_DEVICES_CONF" ] && [ ! -w "$OOB_DEVICES_CONF" ]; then
        _die "cannot write ${OOB_DEVICES_CONF} (re-run with sudo)"
    fi
    if [ ! -e "$OOB_DEVICES_CONF" ]; then
        local dir; dir="$(dirname "$OOB_DEVICES_CONF")"
        { mkdir -p "$dir" && touch "$OOB_DEVICES_CONF"; } 2>/dev/null \
            || _die "cannot create ${OOB_DEVICES_CONF} (re-run with sudo)"
    fi

    local dups
    dups="$(_oob_dup_serials "$raw")"

    printf 'Configuring device mappings in %s\n' "$OOB_DEVICES_CONF"
    printf 'Press Enter to accept the [default], or type "s" to skip a device.\n\n'

    local devnode id_serial vendor model byid bypath existing added=0
    while IFS=$'\t' read -r -u 3 devnode id_serial vendor model byid bypath; do
        [ -n "${devnode:-}" ] || continue
        : "$vendor" "$byid"

        existing="$(_oob_lookup_config "$id_serial" "$bypath")"
        if [ -n "$existing" ]; then
            printf '  %s [%s] -> already mapped as "%s", skipping.\n' \
                "$devnode" "$model" "${existing%%|*}"
            continue
        fi

        local ambiguous=0 path_key=""
        if [ -n "$dups" ] && printf '%s\n' "$dups" | grep -Fxq -- "$id_serial"; then
            ambiguous=1
            [ -z "$bypath" ] || path_key="${bypath##*/}"
        fi

        printf '  Device: %s\n    model=%s serial=%s\n' "$devnode" "$model" "$id_serial"
        if [ "$ambiguous" -eq 1 ]; then
            if [ -n "$path_key" ]; then
                printf '    (another adapter reports the same serial; matching by USB port: %s)\n' "$path_key"
            else
                printf '    warning: another adapter reports the same serial and no USB port path\n'
                printf '    is available; this mapping will apply to both.\n'
            fi
        fi

        local def_name reply name
        def_name="$(_oob_auto_name "$model" "$id_serial" "$bypath" "$ambiguous")"

        name=""
        while [ -z "$name" ]; do
            printf '    name [%s] (or "s" to skip): ' "$def_name"
            read -r reply || reply=""
            reply="$(_oob_trim "$reply")"
            case "$reply" in
                s|S|skip) break ;;
                "") name="$def_name" ;;
                *)
                    name="$(_oob_sanitize_name "$reply")"
                    if [ -z "$name" ]; then
                        printf '    invalid name, use letters, digits, ".", "_" or "-".\n'
                    elif [ "$name" != "$reply" ]; then
                        printf '    using "%s" (allowed: letters, digits, ".", "_", "-")\n' "$name"
                    fi
                    ;;
            esac
        done
        if [ -z "$name" ]; then
            printf '    skipped.\n\n'
            continue
        fi

        local baud data parity stop flow
        _oob_ask "baud" "$OOB_DEFAULT_BAUD" _oob_valid_baud; baud="$_OOB_ANSWER"
        _oob_ask "data bits (5-8)" "$OOB_DEFAULT_DATA" _oob_valid_data; data="$_OOB_ANSWER"
        _oob_ask "parity (none/odd/even)" "$OOB_DEFAULT_PARITY" _oob_valid_parity; parity="$_OOB_ANSWER"
        _oob_ask "stop bits (1/2)" "$OOB_DEFAULT_STOP" _oob_valid_stop; stop="$_OOB_ANSWER"
        _oob_ask "flow (none/soft/hard)" "$OOB_DEFAULT_FLOW" _oob_valid_flow; flow="$_OOB_ANSWER"

        _oob_append_section "$OOB_DEVICES_CONF" "$name" "$id_serial" "$path_key" \
            "$baud" "$data" "$parity" "$stop" "$flow"
        added=$((added + 1))
        if [ -n "$path_key" ]; then
            printf '    added [%s] (match = %s, path = %s)\n\n' "$name" "$id_serial" "$path_key"
        else
            printf '    added [%s] (match = %s)\n\n' "$name" "$id_serial"
        fi
    done 3<<< "$raw"

    if [ "$added" -gt 0 ]; then
        printf 'Wrote %d new mapping(s) to %s\n' "$added" "$OOB_DEVICES_CONF"
        printf 'Apply them with: %s restart\n' "$PROG"
    else
        printf 'No new mappings added.\n'
    fi
}

usage() {
    cat <<EOF
${PROG} - out-of-band USB serial console multiplexer (tio + tmux)

Usage: ${PROG} <command> [args]

Commands:
  discover      List discovered adapters (raw tab-separated records)
  list          Human-friendly table of adapters + resolved config
  start         Start the detached tmux session (one window/adapter)
  attach        Attach to the session (starting it if needed)
  stop          Terminate the session
  restart       Stop then start the session
  status        Show whether the session is running
  config        Map discovered adapters into devices.conf
  help          Show this help

In the tmux session: Ctrl-b n/p switch consoles, Ctrl-b w lists them,
Ctrl-b d detaches, Ctrl-b R relaunches a closed console. Inside a console,
tio quits with Ctrl-t q. Adapters plugged in after start appear on restart.

Config:
  ${OOB_CONF}
  ${OOB_DEVICES_CONF}

Docs: https://github.com/diaznet/oob-usb-serial/wiki
EOF
}

main() {
    local sub="${1:-help}"

    # Session commands act on OOB_USER's tmux server; ensure we are that user
    # (re-execing the full command via runuser/sudo when invoked as root).
    # Done before shifting so the whole original argv is preserved for re-exec.
    case "$sub" in
        start|stop|restart|attach|status)
            _ensure_oob_user "$@"
            ;;
    esac

    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        discover)    cmd_discover "$@" ;;
        list)        cmd_list "$@" ;;
        start)       cmd_start "$@" ;;
        attach)      cmd_attach "$@" ;;
        stop)        cmd_stop "$@" ;;
        restart)     cmd_restart "$@" ;;
        status)      cmd_status "$@" ;;
        config)      cmd_config "$@" ;;
        help|-h|--help) usage ;;
        *) _err "unknown command: $sub"; usage; exit 2 ;;
    esac
}

main "$@"
