#!/usr/bin/env bash
#
# oob-usb-serial: out-of-band USB serial console multiplexer
#
# Discovers USB-to-serial adapters attached to the host and opens each one as a
# named window inside a single detached tmux session, each window running tio
# on the adapter's stable /dev/serial/by-id path. The whole set of consoles is
# then reachable over SSH from a Raspberry Pi acting as an OOB jump host.
#
# Subcommands:
#   discover              List discovered adapters (raw tab-separated records)
#   list                  Human-friendly table of adapters + resolved config
#   start                 Start the detached tmux session (one window/adapter)
#   attach                Attach to the session (starting it if needed)
#   stop                  Terminate the session
#   status                Show whether the session is running
#   interactive           dialog picker: open a single device with tio
#   config                Interactively map adapters into devices.conf
#   help                  Show this help
#
# Configuration:
#   /etc/oob-usb-serial/oob-usb-serial.conf   global defaults
#   /etc/oob-usb-serial/devices.conf          per-device mappings

set -o errexit
set -o nounset
set -o pipefail

PROG="oob-usb-serial"

# ---------------------------------------------------------------------------
# Locate the library directory (installed layout or source tree).
# ---------------------------------------------------------------------------
_self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ -f "/usr/lib/${PROG}/discover.sh" ]; then
    OOB_LIB_DIR="/usr/lib/${PROG}"
elif [ -f "${_self_dir}/../lib/discover.sh" ]; then
    OOB_LIB_DIR="$(cd "${_self_dir}/../lib" && pwd)"
else
    printf '%s: cannot locate library directory\n' "$PROG" >&2
    exit 1
fi
export OOB_LIB_DIR

# ---------------------------------------------------------------------------
# Configuration defaults, then load the global config file if present.
# ---------------------------------------------------------------------------
OOB_CONF="${OOB_CONF:-/etc/${PROG}/oob-usb-serial.conf}"
OOB_DEVICES_CONF="${OOB_DEVICES_CONF:-/etc/${PROG}/devices.conf}"
OOB_SPEEDS_FILE="${OOB_SPEEDS_FILE:-/usr/share/${PROG}/serial_speeds.txt}"

OOB_DEFAULT_BAUD="115200"
OOB_DEFAULT_DATA="8"
OOB_DEFAULT_PARITY="none"
OOB_DEFAULT_STOP="1"
OOB_DEFAULT_FLOW="none"
OOB_SESSION_NAME="oob"
OOB_LOG_DIR=""
OOB_RUNTIME_DIR="/run/${PROG}"

if [ -f "$OOB_CONF" ]; then
    # shellcheck source=/dev/null
    . "$OOB_CONF"
fi

export OOB_DEFAULT_BAUD OOB_DEFAULT_DATA OOB_DEFAULT_PARITY OOB_DEFAULT_STOP \
       OOB_DEFAULT_FLOW OOB_SESSION_NAME OOB_LOG_DIR OOB_DEVICES_CONF OOB_RUNTIME_DIR

# shellcheck source=../lib/discover.sh
. "${OOB_LIB_DIR}/discover.sh"
# shellcheck source=../lib/session-gen.sh
. "${OOB_LIB_DIR}/session-gen.sh"

# tmux is always driven on a dedicated, named socket so the boot service and an
# interactive SSH login unambiguously share the same server/session.
TMUX_SOCKET="oob"
_tmux() { tmux -L "$TMUX_SOCKET" "$@"; }

_err()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
_die()  { _err "$*"; exit 1; }

_require() {
    command -v "$1" >/dev/null 2>&1 || _die "required command '$1' not found"
}

# _oob_device_accessible <path>
# Returns 0 if the device (or its symlink target) is readable+writable.
_oob_device_accessible() {
    local real
    real="$(readlink -f "$1" 2>/dev/null || printf '%s' "$1")"
    [ -e "$real" ] && [ -r "$real" ] && [ -w "$real" ]
}

# _oob_perm_hint <path>
# Explain how to gain serial access (join the dialout group).
_oob_perm_hint() {
    local dev="$1" real grp
    real="$(readlink -f "$dev" 2>/dev/null || printf '%s' "$dev")"
    grp="$(stat -c '%G' "$real" 2>/dev/null || echo dialout)"
    _err "cannot access ${dev}: permission denied."
    _err "Add your user to the '${grp}' group, then log out and back in:"
    _err "    sudo usermod -aG ${grp} \$USER"
    _err "(the packaged 'oob' user is added to dialout automatically.)"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_discover() {
    oob_discover_raw
}

cmd_list() {
    local raw
    raw="$(oob_discover_raw)"
    if [ -z "$raw" ]; then
        printf 'No USB serial adapters found.\n'
        return 0
    fi

    printf '%-12s %-13s %-8s %-7s %-40s %s\n' \
        "NAME" "DEVICE" "BAUD" "FRAMING" "BY-ID" "ID_SERIAL"
    printf '%-12s %-13s %-8s %-7s %-40s %s\n' \
        "----" "------" "----" "-------" "-----" "---------"

    local devnode id_serial vendor model byid cfg name baud data parity stop flow summary
    while IFS=$'\t' read -r devnode id_serial vendor model byid; do
        [ -z "${devnode:-}" ] && continue
        : "$vendor" "$model"
        cfg="$(_oob_lookup_config "$id_serial")"
        if [ -n "$cfg" ]; then
            IFS='|' read -r name baud data parity stop flow <<< "$cfg"
        else
            name="(auto)"
            baud="$OOB_DEFAULT_BAUD"; data="$OOB_DEFAULT_DATA"
            parity="$OOB_DEFAULT_PARITY"; stop="$OOB_DEFAULT_STOP"; flow="$OOB_DEFAULT_FLOW"
        fi
        summary="$(_oob_framing_summary "$data" "$parity" "$stop" "$flow")"
        printf '%-12s %-13s %-8s %-7s %-40s %s\n' \
            "$name" "$devnode" "$baud" "$summary" "$byid" "$id_serial"
    done <<< "$raw"
}

_session_running() {
    _tmux has-session -t "$OOB_SESSION_NAME" 2>/dev/null
}

cmd_start() {
    _require tmux
    _require tio
    if _session_running; then
        _err "session '${OOB_SESSION_NAME}' already running (use 'attach' or 'stop')"
        return 0
    fi

    local raw
    raw="$(oob_discover_raw)"
    if [ -z "$raw" ]; then
        _err "no adapters discovered; not starting an empty session"
        return 1
    fi

    if [ -n "$OOB_LOG_DIR" ]; then
        mkdir -p "$OOB_LOG_DIR" 2>/dev/null \
            || _err "warning: could not create log dir ${OOB_LOG_DIR}"
    fi

    local tmuxconf
    tmuxconf="$(oob_tmux_config_path)"
    oob_generate_tmux_config > "$tmuxconf"

    local devnode id_serial vendor model byid cfg name baud data parity stop flow
    local first=1 windows=0 inaccessible=0
    while IFS=$'\t' read -r devnode id_serial vendor model byid; do
        [ -z "${devnode:-}" ] && continue
        : "$vendor" "$model"

        cfg="$(_oob_lookup_config "$id_serial")"
        if [ -n "$cfg" ]; then
            IFS='|' read -r name baud data parity stop flow <<< "$cfg"
        else
            name="$(_oob_sanitize_name "${model:-serial}_${id_serial}")"
            name="${name:0:24}"
            baud="$OOB_DEFAULT_BAUD"; data="$OOB_DEFAULT_DATA"
            parity="$OOB_DEFAULT_PARITY"; stop="$OOB_DEFAULT_STOP"; flow="$OOB_DEFAULT_FLOW"
        fi

        if ! _oob_device_accessible "$byid"; then
            inaccessible=$((inaccessible + 1))
            _err "warning: cannot access ${byid} (its console window may not stay open)"
        fi

        local tio_cmd
        tio_cmd="$(_oob_tio_command "$name" "$byid" "$baud" "$data" "$parity" "$stop" "$flow")"

        if [ "$first" -eq 1 ]; then
            _tmux -f "$tmuxconf" new-session -d -s "$OOB_SESSION_NAME" -n "$name" "$tio_cmd"
            first=0
        else
            _tmux new-window -t "$OOB_SESSION_NAME" -n "$name" "$tio_cmd"
        fi
        windows=$((windows + 1))
    done <<< "$raw"

    if [ "$windows" -eq 0 ]; then
        _err "no adapters opened; not starting an empty session"
        return 1
    fi

    _tmux select-window -t "$OOB_SESSION_NAME:0" 2>/dev/null || true

    if [ "$inaccessible" -gt 0 ]; then
        local anydev
        anydev="$(oob_discover_raw | awk -F '\t' 'NF{print $5; exit}')"
        _oob_perm_hint "${anydev:-/dev/ttyUSB0}"
    fi
    _err "started detached session '${OOB_SESSION_NAME}' with ${windows} console(s) (attach with: $PROG attach)"
}

cmd_attach() {
    _require tmux
    if ! _session_running; then
        cmd_start
    fi
    exec tmux -L "$TMUX_SOCKET" attach-session -t "$OOB_SESSION_NAME"
}

cmd_stop() {
    _require tmux
    if ! _session_running; then
        _err "session '${OOB_SESSION_NAME}' is not running"
        return 0
    fi
    _tmux kill-session -t "$OOB_SESSION_NAME"
    _err "stopped session '${OOB_SESSION_NAME}'"
}

cmd_status() {
    if _session_running; then
        printf "session '%s': running\n" "$OOB_SESSION_NAME"
        _tmux list-windows -t "$OOB_SESSION_NAME" 2>/dev/null || true
        return 0
    fi
    printf "session '%s': not running\n" "$OOB_SESSION_NAME"
    return 3
}

# _oob_menu_from_file <file> -> populates global _MENU array (tag,label pairs)
# from a one-value-per-line file, skipping comments/blanks.
cmd_interactive() {
    _require dialog
    _require tio

    # --- pick a speed ---
    local -a speed_menu=()
    local n=0 line
    if [ -f "$OOB_SPEEDS_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            [ -z "${line//[[:space:]]/}" ] && continue
            case "$line" in \#*) continue ;; esac
            n=$((n + 1))
            speed_menu+=( "$n" "$line" )
        done < "$OOB_SPEEDS_FILE"
    fi
    if [ "${#speed_menu[@]}" -eq 0 ]; then
        speed_menu=( 1 9600 2 19200 3 38400 4 57600 5 115200 )
    fi

    local choice speed
    choice="$(dialog --nocancel --keep-tite --menu "Select speed:" 22 76 16 \
        "${speed_menu[@]}" 2>&1 >/dev/tty)"
    speed="${speed_menu[$(( choice * 2 - 1 ))]}"

    # --- pick framing parameters (tio vocabulary) ---
    local sel data parity stop flow
    sel="$(dialog --nocancel --keep-tite --default-item 8 --menu "Data bits:" 12 50 4 \
        5 "5" 6 "6" 7 "7" 8 "8" 2>&1 >/dev/tty)"
    data="$sel"
    parity="$(dialog --nocancel --keep-tite --default-item none --menu "Parity:" 12 50 3 \
        none "None" even "Even" odd "Odd" 2>&1 >/dev/tty)"
    stop="$(dialog --nocancel --keep-tite --default-item 1 --menu "Stop bits:" 12 50 2 \
        1 "1" 2 "2" 2>&1 >/dev/tty)"
    flow="$(dialog --nocancel --keep-tite --default-item none --menu "Flow control:" 12 60 3 \
        none "None" hard "Hardware (RTS/CTS)" soft "Software (XON/XOFF)" 2>&1 >/dev/tty)"

    # --- pick a device (prefer the by-id path) ---
    local -a dev_menu=() dev_paths=()
    local raw devnode id_serial vendor model byid
    raw="$(oob_discover_raw)"
    [ -z "$raw" ] && _die "no USB serial adapters found"
    n=0
    while IFS=$'\t' read -r devnode id_serial vendor model byid; do
        [ -z "${devnode:-}" ] && continue
        : "$vendor"
        n=$((n + 1))
        dev_menu+=( "$n" "${devnode} [${model}]" )
        dev_paths+=( "$byid" )
    done <<< "$raw"

    choice="$(dialog --nocancel --keep-tite --menu "Select device:" 22 76 16 \
        "${dev_menu[@]}" 2>&1 >/dev/tty)"
    local device="${dev_paths[$(( choice - 1 ))]}"

    if ! _oob_device_accessible "$device"; then
        _oob_perm_hint "$device"
        exit 1
    fi

    printf 'Opening %s at %s %s...\n' \
        "$device" "$speed" "$(_oob_framing_summary "$data" "$parity" "$stop" "$flow")"
    printf 'To leave the session: Ctrl-t q (tio quit).\n'
    exec tio -b "$speed" -d "$data" -p "$parity" -s "$stop" -f "$flow" "$device"
}

# _oob_append_section <conf> <name> <id_serial> <baud> <data> <parity> <stop> <flow>
_oob_append_section() {
    local conf="$1" name="$2" id="$3" baud="$4" data="$5" parity="$6" stop="$7" flow="$8"
    {
        printf '\n[%s]\n' "$name"
        printf 'match  = %s\n' "$id"
        printf 'baud   = %s\n' "$baud"
        printf 'data   = %s\n' "$data"
        printf 'parity = %s\n' "$parity"
        printf 'stop   = %s\n' "$stop"
        printf 'flow   = %s\n' "$flow"
    } >> "$conf"
}

# Interactive scaffolder: for each unmapped adapter, prompt for name + serial
# line settings and append an INI section to devices.conf.
cmd_config() {
    local raw
    raw="$(oob_discover_raw)"
    if [ -z "$raw" ]; then
        printf 'No USB serial adapters found. Plug in an adapter and retry.\n'
        return 0
    fi

    if [ -e "$OOB_DEVICES_CONF" ] && [ ! -w "$OOB_DEVICES_CONF" ]; then
        _die "cannot write ${OOB_DEVICES_CONF} (re-run with sudo)"
    fi
    if [ ! -e "$OOB_DEVICES_CONF" ]; then
        local dir; dir="$(dirname "$OOB_DEVICES_CONF")"
        { mkdir -p "$dir" && touch "$OOB_DEVICES_CONF"; } 2>/dev/null \
            || _die "cannot create ${OOB_DEVICES_CONF} (re-run with sudo)"
    fi

    printf 'Configuring device mappings in %s\n' "$OOB_DEVICES_CONF"
    printf 'Press Enter to accept the [default], or type "s" to skip a device.\n\n'

    local devnode id_serial vendor model byid existing added=0
    while IFS=$'\t' read -r -u 3 devnode id_serial vendor model byid; do
        [ -z "${devnode:-}" ] && continue
        : "$vendor" "$byid"

        existing="$(_oob_lookup_config "$id_serial")"
        if [ -n "$existing" ]; then
            printf '  %s [%s] -> already mapped as "%s", skipping.\n' \
                "$devnode" "$model" "${existing%%|*}"
            continue
        fi

        printf '  Device: %s\n    model=%s serial=%s\n' "$devnode" "$model" "$id_serial"

        local def_name reply name baud data parity stop flow
        def_name="$(_oob_sanitize_name "${model:-serial}_${id_serial}")"
        def_name="${def_name:0:24}"

        printf '    name [%s] (or "s" to skip): ' "$def_name"
        read -r reply || reply=""
        case "$reply" in
            s|S|skip) printf '    skipped.\n\n'; continue ;;
            "") name="$def_name" ;;
            *) name="$reply" ;;
        esac

        printf '    baud [%s]: ' "$OOB_DEFAULT_BAUD"
        read -r reply || reply=""; baud="${reply:-$OOB_DEFAULT_BAUD}"
        printf '    data bits [%s]: ' "$OOB_DEFAULT_DATA"
        read -r reply || reply=""; data="${reply:-$OOB_DEFAULT_DATA}"
        printf '    parity (none/odd/even) [%s]: ' "$OOB_DEFAULT_PARITY"
        read -r reply || reply=""; parity="${reply:-$OOB_DEFAULT_PARITY}"
        printf '    stop bits [%s]: ' "$OOB_DEFAULT_STOP"
        read -r reply || reply=""; stop="${reply:-$OOB_DEFAULT_STOP}"
        printf '    flow (none/soft/hard) [%s]: ' "$OOB_DEFAULT_FLOW"
        read -r reply || reply=""; flow="${reply:-$OOB_DEFAULT_FLOW}"

        _oob_append_section "$OOB_DEVICES_CONF" "$name" "$id_serial" \
            "$baud" "$data" "$parity" "$stop" "$flow"
        added=$((added + 1))
        printf '    added [%s] (match = %s)\n\n' "$name" "$id_serial"
    done 3<<< "$raw"

    if [ "$added" -gt 0 ]; then
        printf 'Wrote %d new mapping(s) to %s\n' "$added" "$OOB_DEVICES_CONF"
        printf "Apply them with: %s start   (or 'stop' then 'start' if running)\n" "$PROG"
    else
        printf 'No new mappings added.\n'
    fi
}

usage() {
    cat <<EOF
${PROG} - out-of-band USB serial console multiplexer (tio + tmux)

Usage: ${PROG} <command> [args]

Commands:
  discover      List discovered adapters (raw tab-separated records)
  list          Human-friendly table of adapters + resolved config
  start         Start the detached tmux session (one window/adapter)
  attach        Attach to the session (starting it if needed)
  stop          Terminate the session
  status        Show whether the session is running
  interactive   dialog picker: open a single device with tio
  config        Interactively map discovered adapters into devices.conf
  help          Show this help

In the tmux session: Ctrl-b n/p switch consoles, Ctrl-b w lists them,
Ctrl-b d detaches, Ctrl-b R relaunches a closed console. Inside a console,
tio quits with Ctrl-t q.

Config:
  ${OOB_CONF}
  ${OOB_DEVICES_CONF}
EOF
}

main() {
    local sub="${1:-help}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        discover)    cmd_discover "$@" ;;
        list)        cmd_list "$@" ;;
        start)       cmd_start "$@" ;;
        attach)      cmd_attach "$@" ;;
        stop)        cmd_stop "$@" ;;
        status)      cmd_status "$@" ;;
        interactive) cmd_interactive "$@" ;;
        config)      cmd_config "$@" ;;
        help|-h|--help) usage ;;
        *) _err "unknown command: $sub"; usage; exit 2 ;;
    esac
}

main "$@"
