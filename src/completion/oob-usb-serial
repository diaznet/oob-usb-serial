# bash completion for oob-usb-serial
#
# Installed to /usr/share/bash-completion/completions/oob-usb-serial and sourced
# on demand by the bash-completion framework.

_oob_usb_serial() {
    local cur cword
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion || return
    else
        # Minimal fallback if bash-completion helpers are unavailable.
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        cword="$COMP_CWORD"
    fi

    local subcommands="discover list start attach stop status interactive config help"

    # Only the first argument (the subcommand) is completed; the subcommands
    # take no further options.
    if [ "${cword:-$COMP_CWORD}" -eq 1 ]; then
        mapfile -t COMPREPLY < <(compgen -W "$subcommands" -- "$cur")
    else
        COMPREPLY=()
    fi
    return 0
}

complete -F _oob_usb_serial oob-usb-serial
