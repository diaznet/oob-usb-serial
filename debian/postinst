#!/bin/sh
# postinst script for oob-usb-serial
set -e

CONF="/etc/oob-usb-serial/oob-usb-serial.conf"

# The session user comes from OOB_USER in the config (default: oob). Read it
# as text (the last OOB_USER= assignment wins, as when the file is sourced)
# rather than sourcing the file as root.
oob_user() {
    u=""
    if [ -f "$CONF" ]; then
        u="$(sed -n "s/^[[:space:]]*OOB_USER=[\"']\{0,1\}\([A-Za-z0-9_.-]*\)[\"']\{0,1\}.*/\1/p" "$CONF" | tail -n 1)"
    fi
    case "$u" in
        ""|-*|*[!A-Za-z0-9_.-]*) u="oob" ;;
    esac
    printf '%s' "$u"
}

case "$1" in
    configure)
        OOB_USER="$(oob_user)"
        # Create a dedicated system user to own the console session, if it does
        # not already exist. Membership in 'dialout' grants access to the
        # /dev/ttyUSB* serial devices.
        if ! getent passwd "$OOB_USER" >/dev/null 2>&1; then
            adduser --system --group \
                    --home /var/lib/oob-usb-serial \
                    --shell /bin/bash \
                    --gecos "OOB serial console" \
                    "$OOB_USER" || true
        fi
        # Ensure the user can access serial devices.
        if getent group dialout >/dev/null 2>&1; then
            adduser "$OOB_USER" dialout || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

#DEBHELPER#

exit 0
